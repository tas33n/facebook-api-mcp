{
  "name": "facebook-api-mcp",
  "version": "3.5.0-rc.2",
  "description": "Cookie-session Facebook and Messenger API with an agent-facing MCP server.",
  "main": "index.js",
  "author": { "name": "Tas33n", "url": "https://github.com/tas33n" },
  "contributors": ["Al Amin / Nexus-016 (Nexus-FCA)", "Avery, Benjamin, David, Maude (facebook-chat-api)", "ntkhang03 and FCA community contributors"],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --ignoreConfig --noEmit --strict --types node --target ES2022 --module preserve --moduleResolution bundler index.d.ts lib/mcp/index.d.ts",
    "mcp": "node bin/facebook-api-mcp.js",
    "docs:generate": "node scripts/generate-reference.js",
    "test:package": "node --test test/package-contract.test.js",
    "audit": "npm audit --audit-level=low",
    "check": "npm test && npm run typecheck && npm run audit",
    "prepack": "npm run test:package && npm run typecheck"
  },
  "bin": {
    "facebook-api-mcp": "bin/facebook-api-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.8.4",
    "bluebird": "^3.7.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.10",
    "duplexify": "^4.1.3",
    "form-data": "^4.0.5",
    "got": "^11.8.6",
    "gradient-string": "^2.0.2",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "mqtt": "^5.16.1",
    "npmlog": "^7.0.1",
    "socks-proxy-agent": "^8.0.4",
    "tough-cookie": "^6.0.0",
    "ws": "^8.18.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "facebook",
    "chat",
    "api",
    "messenger",
    "bot",
    "automation",
    "login",
    "appstate",
    "typescript",
    "mqtt",
    "mcp"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "eslintConfig": {
    "env": {
      "es6": true,
      "es2017": true,
      "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "sourceType": "module"
    },
    "rules": {
      "linebreak-style": [
        "error",
        "unix"
      ],
      "semi": [
        "error",
        "always"
      ],
      "no-unused-vars": [
        1,
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ],
      "no-empty": [
        "error",
        {
          "allowEmptyCatch": true
        }
      ]
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "utils.js",
    "src/**/*.js",
    "lib/auth/**/*.js",
    "lib/factory/**/*.js",
    "lib/facebook/**/*.js",
    "lib/mcp/**/*.js",
    "lib/mcp/**/*.d.ts",
    "bin/*.js",
    "docs/MCP.md",
    "docs/SETUP.md",
    "docs/AGENT_INTEGRATION.md",
    "docs/API_REFERENCE.md",
    "DOCS.md",
    "ATTRIBUTION.md",
    "LICENSE",
    "prompts/*.md",
    "lib/health/HealthMetrics.js",
    "lib/logger.js",
    "lib/mqtt/**/*.js",
    "lib/network/ProxyManager.js",
    "lib/network/UserAgentManager.js",
    "lib/safety/FacebookSafety.js",
    "README.md",
    "CHANGELOG.md",
    "examples/*.js",
    "examples/mcp-client.json",
    "examples/README.md"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
