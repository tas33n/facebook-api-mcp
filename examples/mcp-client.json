      "env": {
        "FACEBOOK_APP_STATE_PATH": "/absolute/private/path/appstate.json",
        "FACEBOOK_ACTION_LEDGER_PATH": "/absolute/private/path/facebook-actions.json"
      }
    }
  }
}
